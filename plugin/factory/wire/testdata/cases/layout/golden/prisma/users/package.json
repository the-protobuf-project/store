{
  "name": "users-prisma",
  "version": "0.1.0",
  "private": true,
  "description": "Generated Prisma schema for the users database. Managed by protoc-gen-store — edit the source .proto, not these files.",
  "scripts": {
    "prisma:generate": "prisma generate --config users.config.ts",
    "prisma:migrate": "prisma migrate dev --config users.config.ts",
    "prisma:deploy": "prisma migrate deploy --config users.config.ts",
    "prisma:studio": "prisma studio --config users.config.ts",
    "prisma:format": "prisma format --config users.config.ts"
  },
  "dependencies": {
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "dotenv": "^18.0.9",
    "typescript": "^5.9.3",
    "@types/node": "^24.19.2"
  }
}
