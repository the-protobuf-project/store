# Connection URL for the billing_db database.
#
# Copy this file to .env and replace the placeholder with your real credentials:
#
#     cp .env.example .env
#
# .env is git-ignored and is never generated, so your edits survive the next
# `buf generate`. This file is regenerated every time and is committed, so keep
# real credentials out of it. billing_db.config.ts reads the value via
# env("BILLING_DB_DATABASE_URL").
BILLING_DB_DATABASE_URL="postgresql://user:password@localhost:5432/billing_db"
