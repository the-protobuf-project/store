{{.TOMLHeader}}
[package]
name = "{{.Crate}}"
version = "0.1.0"
edition = "2024"
publish = false
description = "Time-series stores generated by protoc-gen-store for InfluxDB 3 and Arrow captures."

# The tree is one crate, as gorm's output is one Go module: lib.rs at the root,
# one module directory per database beside the shared seriesx runtime.
[lib]
path = "lib.rs"

# Redirect to a local checkout without editing this file:
#   [patch."{{.RuntimeGit}}"]
#   {{.RuntimeCrate}} = { path = "../runtime-rs/database" }
[dependencies]
{{.RuntimeCrate}} = { git = "{{.RuntimeGit}}", branch = "{{.RuntimeRef}}" }
