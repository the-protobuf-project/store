## Select the database

```rust
use {{.Lib}}::{{.Module}};

// InfluxDB 3, from INFLUX_HOST / INFLUX_TOKEN (INFLUX_DATABASE overrides "{{.Name}}"):
let influx = {{.Module}}::connect_influx_env().await?;
// Arrow IPC captures, no server:
let arrow = {{.Module}}::open_arrow("captures").await?;
// Both: every point written to InfluxDB and recorded to Arrow.
let db = {{.Module}}::mirror(influx, arrow);
{{.Module}}::ensure_schema(&db).await?;
```

