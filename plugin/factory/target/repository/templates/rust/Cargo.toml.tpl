{{.TOMLHeader}}
[package]
name = "{{.Crate}}"
version = "0.1.0"
edition = "2024"
publish = false
description = "Repositories generated by protoc-gen-store over the tpp-database records runtime."

# The tree is one crate, as the influxdb target's is: lib.rs at the root, one
# module per proto package. Its code names the prost messages through
# {{.ProtoModule}}, so either the crate holds that module or, more often, the
# tree is mounted into the crate that does:
#   #[path = "<out>/lib.rs"] pub mod repository;
[lib]
path = "lib.rs"

# Redirect to a local checkout without editing this file:
#   [patch."{{.RuntimeGit}}"]
#   {{.RuntimeCrate}} = { path = "../runtime-rs/database" }
[dependencies]
{{.RuntimeCrate}} = { git = "{{.RuntimeGit}}", branch = "{{.RuntimeRef}}" }
prost = "0.14"
prost-reflect = "0.16"
